# Токен Discord-бота (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=ВАШ_ТОКЕН_БОТА

# Провайдер синтеза речи: azure (основной) | salute (запасной, SaluteSpeech Сбера).
TTS_PROVIDER=azure

# ============================ Azure Speech ============================
# Ключ и регион ресурса Speech: портал Azure -> ваш ресурс Speech ->
# «Keys and Endpoint» -> KEY 1 и Location/Region (например westeurope).
AZURE_SPEECH_KEY=ВАШ_КЛЮЧ_AZURE
AZURE_SPEECH_REGION=westeurope

# Нестандартный endpoint нужен только для private/custom-развёртываний.
# Если задан, он используется вместо региона. Обычно оставьте пустым.
AZURE_SPEECH_ENDPOINT=

# Несколько ключей с авто-переключением при исчерпании квоты (2-10 шт).
# Если файл существует, он имеет приоритет над AZURE_SPEECH_KEY.
# Шаблон: azure_keys.example.json -> скопировать в azure_keys.json.
AZURE_KEYS_FILE=azure_keys.json

# Голос. Русские нейроголоса: ru-RU-SvetlanaNeural, ru-RU-DmitryNeural,
# ru-RU-DariyaNeural. Полный список — в документации Azure (language-support).
AZURE_VOICE=ru-RU-SvetlanaNeural

# Формат аудио (имя из SpeechSynthesisOutputFormat). Raw*Pcm уходит в ffmpeg
# без разбора контейнера — самый дешёвый по CPU вариант.
AZURE_OUTPUT_FORMAT=Raw24Khz16BitMonoPcm

# Необязательные украшения SSML.
# AZURE_VOICE_STYLE — стиль речи (cheerful, sad, angry, ...). Поддерживается
# не всеми голосами: у русских нейроголосов стилей нет, оставьте пустым.
# AZURE_VOICE_RATE / AZURE_VOICE_PITCH — темп и высота: -10%, +20%, slow, high.
AZURE_VOICE_STYLE=
AZURE_VOICE_RATE=
AZURE_VOICE_PITCH=

# ===================== SaluteSpeech (запасной) ========================
# Заполняйте, только если собираетесь ставить TTS_PROVIDER=salute.
# Authorization key из личного кабинета SaluteSpeech (Studio) —
# это base64(Client ID:Client Secret). Можно взять готовым в кабинете.
SALUTE_AUTH_KEY=

# Версия API (scope): SALUTE_SPEECH_PERS / SALUTE_SPEECH_CORP / SALUTE_SPEECH_B2B
SALUTE_SCOPE=SALUTE_SPEECH_PERS

# Несколько ключей Сбера (шаблон: salute_keys.example.json -> salute_keys.json).
SALUTE_KEYS_FILE=salute_keys.json

# Голос и язык SaluteSpeech: Nec_24000, Bys_24000, May_24000, Tur_24000, ...
SALUTE_VOICE=Nec_24000
SALUTE_LANG=ru

# Проверять TLS-сертификат серверов Сбера (только для TTS_PROVIDER=salute).
# У ngw.devices.sberbank.ru сертификат выпущен НУЦ Минцифры.
# Если корневой сертификат не установлен в систему -> поставьте false (менее безопасно).
VERIFY_SSL=true

# =========================== Общие настройки ==========================
# Язык SSML. Пусто — берётся из имени голоса Azure (ru-RU-SvetlanaNeural -> ru-RU).
TTS_LANG=

# Локальный учёт израсходованных символов по каждому ключу: у Azure нет API
# остатка средств, поэтому расход считает сам бот и показывает по !balance.
# Счётчики обнуляются при смене календарного месяца (как и квота Azure).
# Оставьте USAGE_FILE пустым, чтобы отключить учёт.
USAGE_FILE=usage.json

# Месячная квота символов на один ключ (для процентов в !balance).
# Бесплатный тариф Azure F0 — 500000 символов в месяц на ресурс.
# Поставьте 0, если тариф платный и квоты нет.
MONTHLY_QUOTA_CHARS=500000

# Максимальная длина одного озвучиваемого сообщения (символов).
MAX_TTS_CHARS=4000

# Путь к файлу со списком разрешённых пользователей
ALLOWED_USERS_FILE=allowed_users.json

# ID голосовых каналов, чьи чаты отслеживать (через запятую).
# Бот реагирует только на сообщения в ЧАТЕ голосового канала.
# Если оставить пустым — отслеживаются все голосовые каналы.
# ПКМ по голосовому каналу -> «Копировать ID» (нужен Режим разработчика).
TRACKED_CHANNEL_IDS=111111111111111111,222222222222222222

# Префикс, с которого начинается сообщение, которое НЕ нужно озвучивать.
# Например, "!привет" будет написано в чат, но не прочитано вслух.
SKIP_PREFIX=!

# Префикс команд управления (!join, !leave, !mode). Может совпадать со SKIP_PREFIX.
COMMAND_PREFIX=!

# Кому разрешена команда !speak (принудительная озвучка).
# Роли по ID и/или по названию, через запятую. Администраторы — всегда.
# ID роли: Настройки сервера -> Роли -> ПКМ -> Копировать ID (Режим разработчика).
SPEAK_ROLE_IDS=
SPEAK_ROLE_NAMES=TTS,Озвучка

# Режим подключения по умолчанию: auto | manual.
#   auto   — бот сам заходит в канал и сам выходит по таймауту тишины.
#   manual — бот заходит/выходит только по командам !join / !leave.
# Режим можно менять на лету командой !mode auto / !mode manual.
CONNECTION_MODE=auto

# Сколько минут без сообщений игроков из списка до авто-выхода (только в auto).
IDLE_TIMEOUT_MINUTES=10

# Логи. Пишутся и в консоль, и в файл LOG_FILE (с ротацией).
# Оставьте LOG_FILE пустым, чтобы писать только в консоль.
LOG_FILE=bot.log
LOG_LEVEL=INFO
